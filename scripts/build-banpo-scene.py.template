for k,tint in enumerate([(.63,.63,.58),(.49,.55,.57),(.69,.68,.61),(.37,.45,.47)]):
    m=material('North bank facade '+str(k),tint,.68,.06)
    size=128;px=[];ep=[]
    for y in range(size):
        for x in range(size):
            bay=x//32;floor=y//32;xx=x%32;yy=y%32
            glass=5<xx<25 and 6<yy<25
            rgb=(.13+k*.012,.21+k*.013,.25+k*.014) if glass else tint
            if glass and xx>22:rgb=(.25,.32,.32)
            if yy<2:rgb=tuple(v*.78 for v in tint)
            noise=(random.random()-.5)*.018
            px.extend([max(0,v+noise) for v in rgb]+[1])
            lit=glass and ((bay*17+floor*31+k*7)%9 in [1,3])
            ep.extend([.9 if lit else 0,.58 if lit else 0,.28 if lit else 0,1])
    im=bpy.data.images.new('Facade masonry and glazing '+str(k),width=size,height=size)
    im.pixels=px;im.pack()
    em=bpy.data.images.new('Facade evening windows '+str(k),width=size,height=size)
    em.pixels=ep;em.pack()
    nodes=m.node_tree.nodes;bs=nodes.get('Principled BSDF')
    tex=nodes.new('ShaderNodeTexImage');tex.image=im;tex.extension='REPEAT'
    et=nodes.new('ShaderNodeTexImage');et.image=em;et.extension='REPEAT'
    m.node_tree.links.new(tex.outputs['Color'],bs.inputs['Base Color'])
    m.node_tree.links.new(et.outputs['Color'],bs.inputs['Emission Color'])
    bs.inputs['Emission Strength'].default_value=0

def append(name, mat, vertices, faces, uvs=None):
    key=(name,mat)
    v,f,u=batches.setdefault(key,([],[],[]));offset=len(v)
    v.extend(vertices);f.extend([tuple(offset+i for i in face) for face in faces])
    for face in faces:
        u.extend([uvs[i] if uvs else (vertices[i][0]/15,vertices[i][1]/15) for i in face])

def box(name, mat, center, dims, yaw=0):
    cx,cy,cz=center;dx,dy,dz=[d/2 for d in dims];c,s=math.cos(yaw),math.sin(yaw)
    vs=[]
    for x,y,z in [(-dx,-dy,-dz),(dx,-dy,-dz),(dx,dy,-dz),(-dx,dy,-dz),(-dx,-dy,dz),(dx,-dy,dz),(dx,dy,dz),(-dx,dy,dz)]:
        vs.append((cx+x*c-y*s,cy+x*s+y*c,cz+z))
    append(name,mat,vs,[(0,3,2,1),(4,5,6,7),(0,1,5,4),(1,2,6,5),(2,3,7,6),(3,0,4,7)])

def segment(name,mat,a,b,width,height):
    a,b=Vector(a),Vector(b);delta=b-a
    box(name,mat,(a+b)/2,(width,delta.length,height),-math.atan2(delta.x,delta.y))

def cylinder(name,mat,x,y,z,radius,height,segments=10,top=None):
    top=radius if top is None else top;vs=[]
    for h,r in [(z,radius),(z+height,top)]:
        vs.extend([(x+r*math.cos(i*math.tau/segments),y+r*math.sin(i*math.tau/segments),h) for i in range(segments)])
    fs=[tuple(reversed(range(segments))),tuple(range(segments,segments*2))]
    fs.extend([(i,(i+1)%segments,(i+1)%segments+segments,i+segments) for i in range(segments)])
    append(name,mat,vs,fs)

def polygon_solid(name,mat,poly,bottom,height):
    n=len(poly)
    vs=[(x,y,z) for z in [bottom,bottom+height] for x,y in poly]
    fs=[tuple(range(n,n*2)),tuple(reversed(range(n)))]
    fs.extend([(i,(i+1)%n,(i+1)%n+n,i+n) for i in range(n)])
    append(name,mat,vs,fs)

