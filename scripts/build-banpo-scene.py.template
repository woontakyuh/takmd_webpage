for island in D['islands']:
    poly=island['p'];name=island['name'];polygon_solid('Sebitseom floating island footprints','Island boardwalk',poly,.6,2.6)
    cx=sum(p[0] for p in poly)/len(poly);cy=sum(p[1] for p in poly)/len(poly)
    rx=(max(p[0] for p in poly)-min(p[0] for p in poly))*.40
    ry=(max(p[1] for p in poly)-min(p[1] for p in poly))*.40
    height=25 if name=='가빛섬' else 14 if name=='채빛섬' else 10
    vs=[];N=48;levels=9
    def shell(j,i):
        t=j/levels;a=i/N*math.tau;bulge=.75+.24*math.sin(t*math.pi)
        return (cx+rx*math.cos(a)*bulge+height*t*.13,cy+ry*math.sin(a)*bulge,3.2+t*height)
    for j in range(levels+1):vs.extend([shell(j,i) for i in range(N)])
    fs=[]
    for j in range(levels):
        for i in range(N):fs.append((j*N+i,j*N+(i+1)%N,(j+1)*N+(i+1)%N,(j+1)*N+i))
    fs.append(tuple(range(levels*N,(levels+1)*N)))
    append('Sebitseom curved glass pavilions','Glass blue green',vs,fs)
    for j in [0,2,4,6,8,9]:
        for i in range(N):segment('Sevit horizontal ribbons','Sevit silver ribbons',shell(j,i),shell(j,(i+1)%N),.45,.38)
    for i in range(0,N,3):
        for j in range(levels):segment('Sevit diagonal ribs','Sevit silver ribbons',shell(j,i+j),shell(j+1,i+j+1),.38,.28)
