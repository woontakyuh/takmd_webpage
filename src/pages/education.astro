---
import Card from '../components/Card.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Layout from '../layouts/Layout.astro';
import presentationsData from '../data/presentations.json';

const presentations = presentationsData.presentations;
const educationPresentations = presentations
  .filter((presentation) => /workshop|cadaver|education|training|instructor|course/i.test(`${presentation.name} ${presentation.topics.join(' ')}`))
  .slice(0, 6);

const programs = [
  {
    title: 'International UBE Training Center',
    description: 'Live observation and hands-on training for 80+ surgeons from 15+ countries since 2024.',
    tags: ['International', 'UBE'],
  },
  {
    title: 'ESS Workshop for Beginners',
    description: 'Government-funded national project with Incheon Technopark and Hayan Co., Ltd. for Korean surgeons.',
    tags: ['Beginner', 'Korea'],
  },
  {
    title: 'Cadaver workshop',
    description: 'Anatomic precision, portal planning, and full-sequence procedural rehearsal in realistic conditions.',
    tags: ['Cadaver', 'Anatomy'],
  },
  {
    title: 'Live animal and dummy labs',
    description: 'Stepwise training for instrument handling, hemostasis strategy, and safe endoscopic workflow.',
    tags: ['Hands-on', 'Simulation'],
  },
];
---

<Layout title="Education - Woon Tak Yuh, MD" description="Global endoscopic spine surgery education programs, workshops, and teaching appearances.">
  <main id="main-content">
    <section class="page-shell page-section">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <p class="eyebrow">Education</p>
          <h1 class="serif-display mt-5 text-6xl text-[var(--color-text)] sm:text-7xl">
            Teaching endoscopy as a reproducible language.
          </h1>
        </div>
        <p class="lede">
          The education page reframes workshops, live observation, and international training as a coherent teaching system rather than a scattered event list.
        </p>
      </div>
    </section>

    <section class="page-shell pb-12 sm:pb-16">
      <div class="grid gap-3 md:grid-cols-4">
        <article class="data-card">
          <p class="metric-number">80+</p>
          <p class="mt-3 text-sm font-semibold text-[var(--color-text)]">Surgeons trained</p>
        </article>
        <article class="data-card">
          <p class="metric-number">15+</p>
          <p class="mt-3 text-sm font-semibold text-[var(--color-text)]">Countries represented</p>
        </article>
        <article class="data-card">
          <p class="metric-number">2024</p>
          <p class="mt-3 text-sm font-semibold text-[var(--color-text)]">International center launch</p>
        </article>
        <article class="data-card">
          <p class="metric-number">{presentationsData.count}</p>
          <p class="mt-3 text-sm font-semibold text-[var(--color-text)]">Talks and sessions</p>
        </article>
      </div>
    </section>

    <section class="page-shell page-section border-t border-[var(--color-border)]">
      <SectionHeader
        eyebrow="Method"
        title="Training philosophy"
        description="The goal is safe independent adoption: clear anatomical anchors, progressive complexity, direct feedback, and outcome-aware practice."
      />
      <div class="grid gap-4 md:grid-cols-2">
        {programs.map((program) => (
          <Card title={program.title} description={program.description} tags={program.tags} />
        ))}
      </div>
    </section>

    <section class="page-shell page-section">
      <div class="grid gap-8 lg:grid-cols-[0.35fr_0.65fr]">
        <div>
          <SectionHeader
            eyebrow="Schedule Signal"
            title="Recent teaching-related entries"
            description="Selected schedule items pulled from the presentation JSON, filtered for workshop, education, cadaver, instructor, and course language."
            href="/cv"
            linkText="Full CV"
          />
        </div>
        <div class="data-card">
          <div class="record-list">
            {educationPresentations.map((presentation) => (
              <article class="record-item">
                <div>
                  <p class="record-kicker">{presentation.date}</p>
                  <p class="mt-1 text-xs text-[var(--color-text-muted)]">{presentation.place || 'Location TBA'}</p>
                </div>
                <div>
                  <h2 class="text-base font-semibold leading-7 text-[var(--color-text)]">{presentation.name}</h2>
                  <p class="mt-1 text-sm leading-6 text-[var(--color-text-secondary)]">{presentation.topics[0]}</p>
                  <div class="mt-2 flex flex-wrap gap-2">
                    {presentation.societies.map((society) => (
                      <span class="tag">{society}</span>
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
