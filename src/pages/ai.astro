---
import Card from '../components/Card.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Layout from '../layouts/Layout.astro';
import presentationsData from '../data/presentations.json';
import publicationsData from '../data/publications.json';
import { aiProjects, hasAiSignal } from '../data/ai-projects';

const aiPresentations = presentationsData.presentations.filter((presentation) => hasAiSignal(`${presentation.name} ${presentation.topics.join(' ')}`));
const aiPublications = publicationsData.publications.filter((publication) => hasAiSignal(publication.title));
---

<Layout title="AI Work - Woon Tak Yuh, MD" description="Documented AI-related projects, talks, and publications by Woon Tak Yuh, MD.">
  <main id="main-content">
    <section class="page-shell page-section">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <p class="eyebrow">AI work</p>
          <h1 class="serif-display mt-5 text-6xl text-[var(--color-text)] sm:text-7xl">
            Projects, teaching, and research with a clear source trail.
          </h1>
        </div>
        <p class="lede">
          Projects, lectures, and research exploring AI in practice.
        </p>
      </div>
    </section>

    <section class="page-shell pb-12 sm:pb-16">
      <div class="grid gap-3 md:grid-cols-3">
        <article class="data-card">
          <p class="metric-number">{aiPresentations.length}</p>
          <p class="mt-3 text-sm font-semibold text-[var(--color-text)]">AI-related talks</p>
        </article>
        <article class="data-card">
          <p class="metric-number">{aiPublications.length}</p>
          <p class="mt-3 text-sm font-semibold text-[var(--color-text)]">AI-related papers</p>
        </article>
        <article class="data-card">
          <p class="metric-number">{aiProjects.length}</p>
          <p class="mt-3 text-sm font-semibold text-[var(--color-text)]">Documented side projects</p>
        </article>
      </div>
    </section>

    <section class="page-shell page-section border-t border-[var(--color-border)]">
      <SectionHeader
        eyebrow="Side projects"
        title="Projects in progress"
        description="A workflow study and K-Spinoscopy dashboard project connect AI methods with clinical practice, teaching, and research."
      />
      <div class="grid gap-4 md:grid-cols-2">
        {aiProjects.map((project) => (
          <Card title={project.title} description={project.description} href={project.href} tags={[project.eyebrow]} />
        ))}
      </div>
    </section>

    <section class="page-shell page-section">
      <div class="grid gap-8 lg:grid-cols-[0.35fr_0.65fr]">
        <div>
          <SectionHeader
            eyebrow="Teaching record"
            title="AI-related presentations"
            description="Selected lectures on AI methods, workflow, peer review, imaging, and clinical practice."
            href="/ai-workflow"
            linkText="Detailed workflow"
          />
        </div>
        <div class="data-card">
          <div class="record-list">
            {aiPresentations.map((presentation) => (
              <article class="record-item">
                <div>
                  <p class="record-kicker">{presentation.date}</p>
                  <p class="mt-1 text-xs text-[var(--color-text-muted)]">{presentation.place || 'Location TBA'}</p>
                </div>
                <div>
                  <h2 class="text-base font-semibold leading-7 text-[var(--color-text)]"><a href={`/?exhibit=education&talk=${encodeURIComponent(presentation.id)}`} class="hover:underline">{presentation.name}</a></h2>
                  <p class="mt-1 text-sm leading-6 text-[var(--color-text-secondary)]">{presentation.topics[0]}</p>
                </div>
              </article>
            ))}
            {aiPresentations.length === 0 && <p class="text-sm leading-6 text-[var(--color-text-secondary)]">No AI-related presentation records are available yet.</p>}
          </div>
        </div>
      </div>
    </section>

    <section class="page-shell page-section border-t border-[var(--color-border)]">
      <div class="grid gap-8 lg:grid-cols-[0.35fr_0.65fr]">
        <div>
          <SectionHeader
            eyebrow="Publication record"
            title="AI-related papers"
            description="Published work on deep learning, foundation models, and computational imaging in spine care."
            href="/research"
            linkText="Research archive"
          />
        </div>
        <div class="data-card">
          <div class="record-list">
            {aiPublications.map((publication) => (
              <article class="record-item">
                <div>
                  <p class="record-kicker">{publication.year}</p>
                  <p class="mt-1 text-xs text-[var(--color-text-muted)]">{publication.journal}</p>
                </div>
                <div>
                  <h2 class="text-base font-semibold leading-7 text-[var(--color-text)]"><a href={`/?exhibit=research&paper=${encodeURIComponent(publication.doiUrl || publication.title)}`} class="hover:underline">{publication.title}</a></h2>
                  <p class="mt-1 text-sm leading-6 text-[var(--color-text-secondary)]">{publication.role} · Opens in the research folio</p>
                </div>
              </article>
            ))}
            {aiPublications.length === 0 && <p class="text-sm leading-6 text-[var(--color-text-secondary)]">No AI-related publication records are available yet.</p>}
          </div>
        </div>
      </div>
    </section>

    <section id="spinoscopy" class="page-shell page-section border-t border-[var(--color-border)]">
      <SectionHeader
        eyebrow="K-Spinoscopy dashboard"
        title="Project note in development"
        description="This project is listed as active work. A public project note is being prepared."
      />
    </section>
  </main>
</Layout>
