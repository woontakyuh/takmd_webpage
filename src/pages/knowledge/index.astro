---
import { getCollection } from 'astro:content';
import Card from '../../components/Card.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import TagChip from '../../components/TagChip.astro';
import Layout from '../../layouts/Layout.astro';

const knowledgeEntries = (await getCollection('knowledge', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const tags = Array.from(new Set(knowledgeEntries.flatMap((entry) => entry.data.tags)));
---

<Layout title="Knowledge - Woon Tak Yuh, MD" description="Knowledge notes on UBE, AI, outcomes, and endoscopic spine surgery.">
  <main id="main-content">
    <section class="page-shell page-section">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <p class="eyebrow">Knowledge</p>
          <h1 class="serif-display mt-5 text-6xl text-[var(--color-text)] sm:text-7xl">
            Short notes that keep the record explainable.
          </h1>
        </div>
        <p class="lede">
          The knowledge section is the human layer of the CV: surgical concepts, outcome metrics, AI workflow notes, and teaching language that can be revisited.
        </p>
      </div>
      <div class="mt-8 flex flex-wrap gap-2">
        {tags.length > 0 ? tags.map((tag) => <TagChip label={tag} />) : (
          <>
            <TagChip label="UBE" />
            <TagChip label="AI" />
            <TagChip label="Outcomes" />
            <TagChip label="Workflow" />
          </>
        )}
      </div>
    </section>

    <section class="page-shell page-section border-t border-[var(--color-border)]">
      <SectionHeader
        eyebrow="Notes"
        title="Knowledge base"
        description="Each note should earn its place by helping a reader understand how the clinical, educational, and research work connects."
      />
      {knowledgeEntries.length > 0 ? (
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {knowledgeEntries.map((entry) => (
            <Card
              title={entry.data.title}
              description={entry.data.description}
              href={`/knowledge/${entry.id}`}
              tags={entry.data.tags}
            />
          ))}
        </div>
      ) : (
        <div class="soft-panel">
          <p class="text-sm leading-6 text-[var(--color-text-secondary)]">
            Notes are ready to appear once the content collection is populated.
          </p>
        </div>
      )}
    </section>
  </main>
</Layout>
