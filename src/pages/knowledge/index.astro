---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import TagChip from '../../components/TagChip.astro';

const knowledgeEntries = (await getCollection('knowledge', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout title="Knowledge - takmd" description="Knowledge notes on UBE, AI, outcomes, and endoscopic spine surgery.">
  <section class="page-shell relative overflow-hidden py-14">
    <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.04]" viewBox="0 0 800 320" fill="none" aria-hidden="true">
      <g stroke="currentColor" stroke-width="1" class="text-teal-300">
        <line x1="80" y1="80" x2="220" y2="120" />
        <line x1="220" y1="120" x2="360" y2="70" />
        <line x1="360" y1="70" x2="520" y2="150" />
        <line x1="520" y1="150" x2="700" y2="100" />
        <line x1="220" y1="120" x2="250" y2="230" />
        <line x1="360" y1="70" x2="460" y2="230" />
        <line x1="520" y1="150" x2="620" y2="240" />
      </g>
      <g fill="currentColor" class="text-teal-300">
        <circle cx="80" cy="80" r="3" />
        <circle cx="220" cy="120" r="3" />
        <circle cx="360" cy="70" r="3" />
        <circle cx="520" cy="150" r="3" />
        <circle cx="700" cy="100" r="3" />
        <circle cx="250" cy="230" r="3" />
        <circle cx="460" cy="230" r="3" />
        <circle cx="620" cy="240" r="3" />
      </g>
    </svg>

    <div class="relative">
      <h1 class="page-title-gradient text-4xl font-extrabold sm:text-5xl">Knowledge</h1>
      <div class="mt-6 flex flex-wrap gap-2">
        <TagChip label="UBE" />
        <TagChip label="MISS" />
        <TagChip label="AI" />
        <TagChip label="outcomes" />
        <TagChip label="endoscopy" />
        <TagChip label="workflow" />
        <TagChip label="research" />
      </div>
    </div>
  </section>

  <section class="page-shell pb-16">
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {knowledgeEntries.map((entry) => (
        <Card
          title={entry.data.title}
          description={entry.data.description}
          href={`/knowledge/${entry.id}`}
          tags={entry.data.tags}
        />
      ))}
    </div>
  </section>
</Layout>
