---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/hero/HeroSection.astro";
import publicationsData from "../data/publications.json";
import presentationsData from "../data/presentations.json";
import surgeryData from "../data/surgery-data.json";

const recentPublications = [...(publicationsData.publications ?? [])]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

const today = new Date();
today.setHours(0, 0, 0, 0);

const upcomingPresentations = [...(presentationsData.presentations ?? [])]
  .filter((talk) => new Date(talk.date) >= today)
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())
  .slice(0, 3);

const fallbackPresentations = [...(presentationsData.presentations ?? [])]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

const featuredPresentations = upcomingPresentations.length > 0 ? upcomingPresentations : fallbackPresentations;

const stats = [
  {
    value: String(surgeryData.overallStats.totalCases),
    label: "Total spine cases",
  },
  {
    value: String(publicationsData.count),
    label: "Publications",
  },
  {
    value: String(presentationsData.count),
    label: "Presentations",
  },
  {
    value: "15+",
    label: "Countries trained",
  },
];

const focusAreas = [
  {
    number: "01",
    title: "UBE / Endoscopic Spine Surgery",
    description:
      "Clinical work, operative refinement, and outcome-led practice built around minimally invasive endoscopic techniques.",
    href: "/ube",
    tags: ["UBE", "MIS", "Tumor"],
  },
  {
    number: "02",
    title: "Global Surgical Education",
    description:
      "Training programs, workshops, and faculty activity designed for safe adoption of the technique.",
    href: "/education",
    tags: ["Faculty", "Workshop", "Training"],
  },
  {
    number: "03",
    title: "AI in Clinical Practice",
    description:
      "Practical AI workflow work: imaging, documentation, and clinical systems that actually help the desk and OR.",
    href: "/ai",
    tags: ["Workflow", "Automation", "AI"],
  },
  {
    number: "04",
    title: "Research & Publications",
    description:
      "Selected papers, outputs, and a clean path into the current publication record.",
    href: "/research",
    tags: ["Publications", "Scholar", "Evidence"],
  },
];
---

<Layout
  title="Woon Tak Yuh, MD — Spine Surgeon, Educator & AI Researcher"
  description="TakMD.com is the living brand hub for Woon Tak Yuh, MD: spine surgery, education, clinical AI, research, and professional contact."
  bodyClass="home-magazine"
>
  <main>
    <HeroSection />

    <section class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-18">
      <div class="grid gap-10 lg:grid-cols-[1.02fr_0.98fr] lg:items-start">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-[var(--color-text-muted)]">What this site is now</p>
          <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-[-0.04em] text-[var(--color-text)] sm:text-4xl lg:text-5xl lg:leading-[1.02]">
            A living profile, not an old-school personal homepage.
          </h2>
          <p class="mt-5 max-w-xl text-base leading-8 text-[var(--color-text-secondary)] sm:text-lg">
            The homepage now opens with a stronger visual, then immediately answers the practical questions:
            what you do, what you’re building, and where the work is showing up.
          </p>
          <p class="mt-4 max-w-xl text-sm uppercase tracking-[0.22em] text-[var(--color-text-muted)]">
            Updated live as the practice, publications, talks, and projects change.
          </p>
        </div>

        <div class="rounded-[2rem] border border-[var(--color-border-strong)] bg-[var(--color-surface)] p-5 sm:p-6">
          <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            {stats.map((stat) => (
              <div class="rounded-[1.5rem] border border-[var(--color-border)] bg-[var(--color-bg)] p-4">
                <p class="text-3xl font-semibold tracking-[-0.05em] text-[var(--color-text)] sm:text-[2.3rem]">{stat.value}</p>
                <p class="mt-1 text-sm text-[var(--color-text-secondary)]">{stat.label}</p>
              </div>
            ))}
          </div>
          <div class="mt-5 grid gap-3 border-t border-[var(--color-border)] pt-5 sm:grid-cols-3">
            <div>
              <p class="text-[10px] uppercase tracking-[0.24em] text-[var(--color-text-muted)]">Clinical anchor</p>
              <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">UBE / endoscopic spine surgery as the core lane.</p>
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-[0.24em] text-[var(--color-text-muted)]">Expansion</p>
              <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">Education, AI workflow, publications, and speaking.</p>
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-[0.24em] text-[var(--color-text-muted)]">Goal</p>
              <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">One place that always reflects the current state of the work.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-[var(--color-border-strong)] bg-[rgba(255,255,255,0.01)]">
      <div class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-18">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-[var(--color-text-muted)]">Current focus</p>
            <h2 class="mt-3 text-2xl font-semibold tracking-[-0.04em] text-[var(--color-text)] sm:text-3xl">
              Four lanes, one narrative.
            </h2>
          </div>
          <p class="max-w-2xl text-sm leading-7 text-[var(--color-text-secondary)]">
            Not a random pile of links. Each lane reinforces the same brand: clinical expertise, global education,
            practical AI, and the output record that proves the work.
          </p>
        </div>

        <div class="mt-8 grid gap-4 md:grid-cols-2">
          {focusAreas.map((item) => (
            <a
              href={item.href}
              class="group rounded-[2rem] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition duration-200 hover:-translate-y-1 hover:border-[var(--color-border-hover)] hover:bg-[var(--color-surface-alt)]"
            >
              <div class="flex items-start justify-between gap-4">
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[var(--color-text-muted)]">{item.number}</p>
                <p class="text-xs uppercase tracking-[0.2em] text-[var(--color-link)] opacity-0 transition group-hover:opacity-100">Open →</p>
              </div>
              <h3 class="mt-4 max-w-xl text-2xl font-semibold tracking-[-0.04em] text-[var(--color-text)] sm:text-[1.7rem]">{item.title}</h3>
              <p class="mt-3 max-w-2xl text-sm leading-7 text-[var(--color-text-secondary)]">{item.description}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-1 text-[11px] uppercase tracking-[0.16em] text-[var(--color-text-secondary)]">{tag}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-18">
      <div class="grid gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-start">
        <div class="lg:sticky lg:top-24">
          <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-[var(--color-text-muted)]">Selected publications</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-[var(--color-text)] sm:text-4xl">
            Recent work, pulled from the live record.
          </h2>
          <p class="mt-4 max-w-lg text-sm leading-7 text-[var(--color-text-secondary)]">
            This section is meant to read like a current portfolio, not an archived bibliography.
          </p>
          <a href="/research" class="mt-6 inline-flex items-center rounded-full border border-[var(--color-border-strong)] bg-[var(--color-surface)] px-5 py-3 text-sm font-medium text-[var(--color-text)] transition hover:-translate-y-0.5 hover:border-[var(--color-border-hover)]">
            Open research page →
          </a>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
          {recentPublications.map((pub) => (
            <article class="rounded-[1.75rem] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition duration-200 hover:-translate-y-1 hover:border-[var(--color-border-hover)] hover:bg-[var(--color-surface-alt)]">
              <p class="text-[10px] uppercase tracking-[0.22em] text-[var(--color-text-muted)]">{pub.journal} · {pub.year}</p>
              <h3 class="mt-4 text-base font-semibold leading-snug tracking-[-0.03em] text-[var(--color-text)]">
                {pub.shortTitle || pub.title}
              </h3>
              <p class="mt-4 text-sm leading-7 text-[var(--color-text-secondary)]">
                {pub.role === "first" ? "First-author output" : pub.role === "corresponding" ? "Corresponding-author output" : "Collaborative publication"}
              </p>
              <a href={pub.doiUrl} target="_blank" rel="noreferrer" class="mt-5 inline-flex text-sm font-medium text-[var(--color-link)] transition hover:text-[var(--color-text)]">
                DOI →
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-[var(--color-border-strong)] bg-[rgba(255,255,255,0.01)]">
      <div class="mx-auto grid w-full max-w-7xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[0.88fr_1.12fr] lg:px-8 lg:py-18">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-[var(--color-text-muted)]">Speaking / recent talks</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-[var(--color-text)] sm:text-4xl">
            A live snapshot of the speaking calendar.
          </h2>
          <p class="mt-4 max-w-lg text-sm leading-7 text-[var(--color-text-secondary)]">
            The point here is simple: the site should tell visitors what’s happening now, not only what happened years ago.
          </p>
          <a href="/education" class="mt-6 inline-flex items-center rounded-full border border-[var(--color-border-strong)] bg-[var(--color-surface)] px-5 py-3 text-sm font-medium text-[var(--color-text)] transition hover:-translate-y-0.5 hover:border-[var(--color-border-hover)]">
            Open education page →
          </a>
        </div>

        <div class="space-y-3">
          {featuredPresentations.map((talk) => (
            <article class="rounded-[1.5rem] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition duration-200 hover:border-[var(--color-border-hover)] hover:bg-[var(--color-surface-alt)]">
              <div class="flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.22em] text-[var(--color-text-muted)]">
                <span>{talk.date}</span>
                <span>•</span>
                <span>{talk.place || "TBA"}</span>
              </div>
              <h3 class="mt-3 text-lg font-semibold tracking-[-0.03em] text-[var(--color-text)]">{talk.name}</h3>
              <p class="mt-2 text-sm leading-7 text-[var(--color-text-secondary)]">{talk.topics.join(" · ")}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-18">
      <div class="grid gap-px overflow-hidden rounded-[2rem] border border-[var(--color-border-strong)] bg-[var(--color-border-strong)] md:grid-cols-3">
        <div class="bg-[var(--color-surface)] p-6 sm:p-8">
          <p class="text-[11px] font-semibold uppercase tracking-[0.26em] text-[var(--color-text-muted)]">Fast paths</p>
          <div class="mt-5 space-y-2 text-sm text-[var(--color-text-secondary)]">
            <a class="block transition hover:text-[var(--color-text)]" href="/dashboard">Dashboard →</a>
            <a class="block transition hover:text-[var(--color-text)]" href="/knowledge">Knowledge base →</a>
            <a class="block transition hover:text-[var(--color-text)]" href="/media">Media →</a>
          </div>
        </div>
        <div class="bg-[var(--color-surface)] p-6 sm:p-8">
          <p class="text-[11px] font-semibold uppercase tracking-[0.26em] text-[var(--color-text-muted)]">Profile links</p>
          <div class="mt-5 space-y-2 text-sm text-[var(--color-text-secondary)]">
            <a class="block transition hover:text-[var(--color-text)]" href="https://scholar.google.com/citations?user=tbTBemUAAAAJ&hl=ko&oi=ao" target="_blank" rel="noreferrer">Google Scholar →</a>
            <a class="block transition hover:text-[var(--color-text)]" href="https://www.linkedin.com/in/woon-tak-yuh-03420311b/" target="_blank" rel="noreferrer">LinkedIn →</a>
            <a class="block transition hover:text-[var(--color-text)]" href="mailto:woontak.yuh@gmail.com">Email →</a>
          </div>
        </div>
        <div class="bg-[var(--color-surface)] p-6 sm:p-8">
          <p class="text-[11px] font-semibold uppercase tracking-[0.26em] text-[var(--color-text-muted)]">Brand note</p>
          <p class="mt-5 max-w-sm text-sm leading-7 text-[var(--color-text-secondary)]">
            Old personal-site energy is out. This is now a living hub: clinical anchor, education engine,
            research record, and practical contact surface.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
