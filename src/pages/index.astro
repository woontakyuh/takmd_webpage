---
import DeskScene from '../components/desk-scene/DeskScene';
import Layout from '../layouts/Layout.astro';
import presentationsData from '../data/presentations.json';
import publicationsData from '../data/publications.json';
import surgeryData from '../data/surgery-data.json';

const cases = surgeryData.cases;

const metrics = {
  publications: publicationsData.count,
  presentations: presentationsData.count,
  cases: cases.length,
  latestCase: cases.at(-1)?.opDate ?? 'TBA',
};
---

<Layout
  title="TakMD - Woon Tak Yuh, MD"
  description="Interactive 3D desk homepage for Woon Tak Yuh, MD: spine surgery, education, research, clinical AI workflow, and living CV."
  hideNav
  hideFooter
  bodyClass="bg-[#0d1018]"
>
  <main id="main-content">
    <DeskScene client:only="react" metrics={metrics} />

    <noscript>
      <section class="min-h-screen bg-[#03060b] px-6 py-16 text-white">
        <div class="mx-auto max-w-3xl">
          <p class="eyebrow text-white/45">Woon Tak Yuh, MD</p>
          <h1 class="mt-5 text-5xl font-semibold tracking-[-0.06em]">Spine surgeon, educator, clinical AI builder.</h1>
          <p class="mt-5 text-lg leading-8 text-white/65">
            Enable JavaScript to use the interactive desk. The living CV and public routes remain available below.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/cv" class="button-primary">Living CV</a>
            <a href="/ube" class="button-secondary">UBE</a>
            <a href="/education" class="button-secondary">Education</a>
            <a href="/ai" class="button-secondary">AI</a>
            <a href="/research" class="button-secondary">Research</a>
          </div>
        </div>
      </section>
    </noscript>
  </main>
</Layout>
