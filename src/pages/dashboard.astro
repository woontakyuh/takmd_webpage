---
import Layout from '../layouts/Layout.astro';
import '@fontsource-variable/manrope';
---

<Layout
  title="Private Workspace — TakMD"
  description="This workspace is unavailable on the public site."
  hideNav
  hideFooter
>
  <main id="main-content" class="private-workspace">
    <div class="workspace-content">
      <a class="wordmark" href="/" aria-label="TakMD home">TakMD<span>.</span></a>
      <p class="eyebrow">Private workspace</p>
      <h1>A separate<br /><em>workspace.</em></h1>
      <p class="description">This workspace is unavailable on the public site.</p>
      <a class="return-link" href="/">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="m12 5-7 7 7 7M5 12h14" />
        </svg>
        Return to the studio
      </a>
    </div>
  </main>
</Layout>

<style>
  .private-workspace {
    --studio-paper: #eae8e1;
    --studio-ink: #202d2a;
    --studio-muted: #5c655f;
    --studio-teal: #355a50;
    --studio-line: #cbcdc3;
    min-height: 100dvh;
    display: grid;
    align-items: center;
    padding: 48px 24px;
    background: var(--studio-paper);
    color: var(--studio-ink);
    font-family: 'Manrope Variable', sans-serif;
  }

  .workspace-content { width: min(100%, 640px); margin-inline: auto; }
  .wordmark { display: inline-block; margin-bottom: 80px; font-size: 24px; font-weight: 800; letter-spacing: -0.065em; }
  .wordmark span { color: var(--studio-teal); }
  .eyebrow { margin-bottom: 24px; color: var(--studio-muted); font: 12px ui-monospace, monospace; letter-spacing: 0.12em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(48px, 8vw, 80px); line-height: 1.02; letter-spacing: -0.065em; font-weight: 500; }
  h1 em { font-family: Georgia, serif; font-weight: 400; }
  .description { margin-top: 32px; max-width: 32ch; font-size: 18px; line-height: 1.65; color: var(--studio-muted); }
  .return-link { display: inline-flex; align-items: center; gap: 12px; min-height: 48px; margin-top: 40px; padding-block: 12px; border-bottom: 1px solid var(--studio-line); font-size: 14px; color: var(--studio-teal); }
  a:hover { text-decoration: underline; text-underline-offset: 4px; }
  a:focus-visible { outline: 2px solid var(--studio-teal); outline-offset: 4px; }
</style>
