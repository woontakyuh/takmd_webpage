---
import Layout from '../layouts/Layout.astro';
import DashboardWithAuth from '../components/DashboardWithAuth';
---

<Layout
  title="Surgery Dashboard — W.T. Yuh, MD"
  description="Surgical case analytics dashboard — 1,830 spine surgery cases"
  hideNav
  hideFooter
>
  <DashboardWithAuth client:load />
</Layout>

<style is:global>
  /* Reset to light theme for dashboard — scoped to main, not body,
     so the auth terminal overlay keeps its dark theme + green text */
  body > main,
  body > div > main {
    --color-text-primary: #1c1917;
    --color-text-secondary: #57534e;
    --color-text-tertiary: #a8a29e;
    color: #1c1917;
  }
</style>
