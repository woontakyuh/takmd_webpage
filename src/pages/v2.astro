---
import DeskScene from '../components/desk-scene/DeskScene';
import Layout from '../layouts/Layout.astro';
import presentationsData from '../data/presentations.json';
import publicationsData from '../data/publications.json';
import surgerySummary from '../data/public-surgery-summary.json';

const metrics = {
  publications: publicationsData.count,
  presentations: presentationsData.count,
  cases: surgerySummary.totalCases,
};
---

<Layout
  title="TakMD - Woon Tak Yuh, MD (v2)"
  description="Track B draft: Heffernan-scene variant of the TakMD interactive desk."
  hideNav
  hideFooter
  bodyClass="bg-[#0a0a0c]"
>
  <main id="main-content">
    <DeskScene client:only="react" metrics={metrics} scene="henry" />
  </main>
</Layout>
