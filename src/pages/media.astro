---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import TagChip from '../components/TagChip.astro';

const mediaEntries = (await getCollection('media', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout title="Media - takmd" description="Media archive including videos, talks, vlogs, and reviews.">
  <section class="page-shell py-14">
    <h1 class="page-title-gradient text-4xl font-extrabold sm:text-5xl">Media</h1>
    <div class="mt-6 flex flex-wrap gap-2">
      <TagChip label="All" color="border-[var(--color-border-strong)] bg-[var(--color-accent-soft)] text-[var(--color-link)]" />
      <TagChip label="Videos" />
      <TagChip label="Talks" />
      <TagChip label="Vlogs" />
      <TagChip label="Reviews" />
    </div>
  </section>

  <section class="page-shell pb-16">
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {mediaEntries.map((entry) => (
        <Card
          title={entry.data.title}
          description={entry.data.description}
          href={entry.data.url ?? '/media'}
          tags={[entry.data.mediaType, ...entry.data.tags]}
        />
      ))}
    </div>
  </section>
</Layout>
