---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - takmd" description="Contact and professional links for Woon Tak Yuh, MD.">
  <section class="mx-auto flex w-full max-w-4xl flex-col items-center px-4 py-14 text-center sm:px-6 sm:py-20">
    <h1 class="page-title-gradient text-4xl font-extrabold sm:text-5xl">Contact</h1>
    <p class="mt-3 text-[var(--color-text-secondary)]">Professional contact and profile links.</p>

    <div class="mt-10 grid w-full gap-4 sm:grid-cols-2">
      <a href="mailto:woontak.yuh@gmail.com" class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 text-left transition duration-200 hover:-translate-y-0.5 hover:border-[var(--color-border-hover)]">
        <p class="text-sm text-[var(--color-text-muted)]">Email</p>
        <p class="mt-1 text-[var(--color-text)]">woontak.yuh@gmail.com</p>
      </a>
      <a href="https://www.davoshospital.co.kr/depart/page02-detail.html?dr_idx=139" target="_blank" rel="noreferrer" class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 text-left transition duration-200 hover:-translate-y-0.5 hover:border-[var(--color-border-hover)]">
        <p class="text-sm text-[var(--color-text-muted)]">Hospital</p>
        <p class="mt-1 text-[var(--color-text)]">Davos Hospital</p>
      </a>
      <a href="https://www.linkedin.com/in/woon-tak-yuh-03420311b/" target="_blank" rel="noreferrer" class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 text-left transition duration-200 hover:-translate-y-0.5 hover:border-[var(--color-border-hover)]">
        <p class="text-sm text-[var(--color-text-muted)]">LinkedIn</p>
        <p class="mt-1 text-[var(--color-text)]">Professional profile</p>
      </a>
      <a href="https://scholar.google.com/citations?user=tbTBemUAAAAJ&hl=ko&oi=ao" target="_blank" rel="noreferrer" class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 text-left transition duration-200 hover:-translate-y-0.5 hover:border-[var(--color-border-hover)]">
        <p class="text-sm text-[var(--color-text-muted)]">Google Scholar</p>
        <p class="mt-1 text-[var(--color-text)]">Publication record</p>
      </a>
      <a href="https://www.researchgate.net/profile/Woon-Tak-Yuh?ev=hdr_xprf" target="_blank" rel="noreferrer" class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 text-left transition duration-200 hover:-translate-y-0.5 hover:border-[var(--color-border-hover)]">
        <p class="text-sm text-[var(--color-text-muted)]">ResearchGate</p>
        <p class="mt-1 text-[var(--color-text)]">Research profile</p>
      </a>
      <a href="https://instagram.com/takmd" target="_blank" rel="noreferrer" class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 text-left transition duration-200 hover:-translate-y-0.5 hover:border-[var(--color-border-hover)]">
        <p class="text-sm text-[var(--color-text-muted)]">Instagram</p>
        <p class="mt-1 text-[var(--color-text)]">@takmd</p>
      </a>
    </div>
  </section>
</Layout>
