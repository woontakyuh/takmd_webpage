---
import SectionHeader from '../components/SectionHeader.astro';
import Layout from '../layouts/Layout.astro';

const contactCards = [
  {
    label: 'Email',
    value: 'woontak.yuh@gmail.com',
    description: 'Best for collaboration, education, research, and professional inquiries.',
    href: 'mailto:woontak.yuh@gmail.com',
  },
  {
    label: 'Hospital',
    value: 'Davos Hospital',
    description: 'Clinical profile and hospital-facing professional information.',
    href: 'https://www.davoshospital.co.kr/depart/page02-detail.html?dr_idx=139',
  },
  {
    label: 'Google Scholar',
    value: 'Publication record',
    description: 'Citation profile and indexed publication record.',
    href: 'https://scholar.google.com/citations?user=tbTBemUAAAAJ&hl=ko&oi=ao',
  },
  {
    label: 'LinkedIn',
    value: 'Professional profile',
    description: 'Professional network, current work, and collaborations.',
    href: 'https://www.linkedin.com/in/woon-tak-yuh-03420311b/',
  },
  {
    label: 'ResearchGate',
    value: 'Research profile',
    description: 'Research network and publication discovery.',
    href: 'https://www.researchgate.net/profile/Woon-Tak-Yuh?ev=hdr_xprf',
  },
  {
    label: 'Instagram',
    value: '@takmd',
    description: 'Public personal signal and occasional field notes.',
    href: 'https://instagram.com/takmd',
  },
];
---

<Layout title="Contact - Woon Tak Yuh, MD" description="Contact and professional links for Woon Tak Yuh, MD.">
  <main id="main-content">
    <section class="page-shell page-section">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <p class="eyebrow">Contact</p>
          <h1 class="serif-display mt-5 text-6xl text-[var(--color-text)] sm:text-7xl">
            Clear paths for the right conversation.
          </h1>
        </div>
        <p class="lede">
          For education, research, clinical AI workflow, lectures, and professional collaboration, email is the safest first route.
        </p>
      </div>
    </section>

    <section class="page-shell page-section border-t border-[var(--color-border)]">
      <SectionHeader
        eyebrow="Routes"
        title="Professional links"
        description="A small set of verified paths instead of a crowded social footer."
      />
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {contactCards.map((card) => (
          <a href={card.href} target={card.href.startsWith('http') ? '_blank' : undefined} rel={card.href.startsWith('http') ? 'noreferrer' : undefined} class="link-card">
            <p class="record-kicker">{card.label}</p>
            <h2 class="mt-3 text-lg font-semibold text-[var(--color-text)]">{card.value}</h2>
            <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">{card.description}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>
