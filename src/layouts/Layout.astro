---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  hideNav?: boolean;
  hideFooter?: boolean;
}

const {
  title = "Woon Tak Yuh, MD — Spine Surgeon & AI Researcher",
  description = "Woon Tak Yuh, MD - Neurosurgeon specializing in endoscopic spine surgery (UBE) and clinical AI research. Director of Spine Endoscopy Center.",
  hideNav = false,
  hideFooter = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://takmd.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Woon Tak Yuh" />

    <link rel="canonical" href={canonicalURL.href} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content="https://takmd.com/desk-setup.webp" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://takmd.com/desk-setup.webp" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/legacy.css" />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Woon Tak Yuh",
      "jobTitle": "Spine Surgeon & AI Researcher",
      "description": "Neurosurgeon specializing in endoscopic spine surgery (UBE) and clinical AI research",
      "url": "https://takmd.com",
      "sameAs": [
        "https://scholar.google.com/citations?user=tbTBemUAAAAJ",
        "https://www.linkedin.com/in/woon-tak-yuh-03420311b/",
        "https://www.researchgate.net/profile/Woon-Tak-Yuh",
        "https://github.com/woontakyuh",
        "https://www.youtube.com/@takmd"
      ],
      "knowsAbout": [
        "Unilateral Biportal Endoscopy",
        "Spine Surgery",
        "Clinical AI",
        "Deep Learning",
        "Surgical Education"
      ]
    })} />
  </head>
  <body class="min-h-screen">
    {!hideNav && <Nav />}
    <slot />
    {!hideFooter && <Footer />}
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
