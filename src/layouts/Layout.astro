---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Woon Tak Yuh, MD — Spine Surgeon & AI Researcher",
  description = "Woon Tak Yuh, MD - Neurosurgeon specializing in endoscopic spine surgery (UBE) and clinical AI research. Director of Spine Endoscopy Center."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Woon Tak Yuh" />
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://takmd.com" />
    
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/legacy.css" />
    
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
