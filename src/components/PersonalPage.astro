---
import Layout from '../layouts/Layout.astro';
import { personalInterests } from './studio/personal';
import type { PersonalInterest } from './studio/personal';

interface Props { readonly interest: PersonalInterest }
const { interest } = Astro.props;
const content = personalInterests[interest];
const other = personalInterests[interest === 'bjj' ? 'surfing' : 'bjj'];
const email = `mailto:woontak.yuh@gmail.com?subject=${encodeURIComponent(content.emailSubject)}`;
---

<Layout title={`${content.title.slice(0, -1)} — Woon Tak Yuh`} description={content.introduction}>
  <main id="main-content" class="personal-page page-shell">
    <a class="personal-return" href="/">← Back to the office</a>
    <p class="eyebrow">{content.eyebrow}</p>
    <h1 class="serif-display">{content.title}</h1>
    <p class="lede">{content.introduction}</p>
    <section class="personal-object" aria-labelledby="personal-object-title">
      <p class="eyebrow">An object in the office</p>
      <div><h2 id="personal-object-title">{content.object}</h2><p>{content.description}</p></div>
    </section>
    <nav class="personal-links" aria-label="Personal links">
      <a href="https://instagram.com/takmd" target="_blank" rel="noreferrer"><span>Personal profile</span><strong>Instagram · @takmd</strong><span aria-hidden="true">↗</span></a>
      <a href={email}><span>Get in touch</span><strong>Say hello by email</strong><span aria-hidden="true">↗</span></a>
      <a href={other.route}><span>Outside the office</span><strong>{other.title}</strong><span aria-hidden="true">→</span></a>
    </nav>
  </main>
</Layout>

<style>
  .personal-page { padding-block: clamp(32px, 6vw, 80px); }
  .personal-return { display: inline-flex; min-height: 44px; align-items: center; margin-bottom: 48px; color: var(--color-text-secondary); font-size: 14px; }
  .personal-page h1 { margin-block: 24px; font-size: clamp(64px, 10vw, 96px); line-height: 1.02; letter-spacing: -.065em; }
  .personal-page > .lede { max-width: 36rem; }
  .personal-object { display: grid; grid-template-columns: 1fr 2fr; gap: 32px; border-top: 1px solid var(--color-border); margin-top: 64px; padding-block: 32px; }
  .personal-object h2 { margin: 0 0 16px; font-size: 24px; letter-spacing: -.025em; }
  .personal-object p:not(.eyebrow) { max-width: 40rem; line-height: 1.75; color: var(--color-text-secondary); }
  .personal-links { margin-top: 24px; }
  .personal-links a { display: grid; grid-template-columns: 1fr 2fr auto; align-items: center; gap: 32px; min-height: 80px; border-top: 1px solid var(--color-border); padding-block: 20px; }
  .personal-links a > span:first-child { font-size: 12px; color: var(--color-text-secondary); }
  .personal-links strong { font-weight: 500; }
  .personal-page a:hover strong, .personal-return:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 759px) {
    .personal-return { margin-bottom: 24px; }
    .personal-object { grid-template-columns: 1fr; gap: 20px; margin-top: 40px; }
    .personal-links a { grid-template-columns: 1fr auto; gap: 8px 16px; }
    .personal-links a > span:first-child { grid-column: 1 / -1; }
  }
</style>
