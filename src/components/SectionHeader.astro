---
interface Props {
  title: string;
  description?: string;
  href?: string;
  linkText?: string;
  icon?: string;
  eyebrow?: string;
}

const { title, description, href, linkText = 'View all', eyebrow = 'Section' } = Astro.props;
---

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div class="max-w-2xl">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="mt-3 font-serif text-3xl tracking-[-0.035em] text-[var(--color-text)] sm:text-4xl">{title}</h2>
    {description && <p class="mt-3 text-sm leading-6 text-[var(--color-text-secondary)] sm:text-base">{description}</p>}
  </div>
  {href && (
    <a href={href} class="text-link">
      {linkText}
    </a>
  )}
</div>
