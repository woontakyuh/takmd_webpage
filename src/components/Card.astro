---
interface Props {
  title: string;
  description: string;
  href?: string;
  tags?: string[];
}

const { title, description, href, tags = [] } = Astro.props;
const cardClass = href ? 'link-card' : 'data-card';
---

{href ? (
  <a href={href} class={cardClass}>
    <h3 class="text-lg font-semibold tracking-[-0.01em] text-[var(--color-text)]">{title}</h3>
    <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">{description}</p>
    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="tag">
            {tag}
          </span>
        ))}
      </div>
    )}
  </a>
) : (
  <article class={cardClass}>
    <h3 class="text-lg font-semibold tracking-[-0.01em] text-[var(--color-text)]">{title}</h3>
    <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">{description}</p>
    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="tag">
            {tag}
          </span>
        ))}
      </div>
    )}
  </article>
)}
