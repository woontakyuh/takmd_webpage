---
const currentDate = new Date();
const dateLabel = new Intl.DateTimeFormat('en', {
  month: 'short',
  day: '2-digit',
  year: 'numeric',
}).format(currentDate);
---

<section class="relative overflow-hidden border-b border-[var(--color-border-strong)] bg-[var(--color-bg)] pt-6 sm:pt-8">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
      <div class="pb-2 lg:pb-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-[var(--color-text-muted)]">
          Living profile · clinical anchor · education engine · research record
        </p>

        <div class="mt-5 max-w-3xl">
          <p class="text-sm leading-7 text-[var(--color-text-secondary)] sm:text-base">
            TakMD.com is the current surface for the work: spine surgery, education, clinical AI,
            research, speaking, and the projects that connect them. It updates as the work changes —
            not as a static personal homepage.
          </p>

          <h1 class="mt-4 text-5xl font-semibold tracking-[-0.05em] text-[var(--color-text)] sm:text-6xl lg:text-[5.6rem] lg:leading-[0.92]">
            Woon Tak Yuh, MD.
          </h1>

          <p class="mt-4 max-w-2xl text-lg leading-8 text-[var(--color-text-secondary)] sm:text-xl">
            Spine surgeon, endoscopic educator, and clinical AI researcher.
            <span class="text-[var(--color-text)]">A live brand hub for what I do, what I build, and where the work shows up.</span>
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/ube" class="inline-flex items-center rounded-full border border-[var(--color-border-strong)] bg-[var(--color-surface)] px-5 py-3 text-sm font-medium text-[var(--color-text)] transition hover:-translate-y-0.5 hover:border-[var(--color-border-hover)]">
            Explore UBE
          </a>
          <a href="/contact" class="inline-flex items-center rounded-full bg-[var(--color-text)] px-5 py-3 text-sm font-medium text-[var(--color-bg)] transition hover:-translate-y-0.5 hover:opacity-90">
            Contact
          </a>
          <a href="/research" class="inline-flex items-center rounded-full border border-transparent px-5 py-3 text-sm font-medium text-[var(--color-link)] transition hover:text-[var(--color-text)]">
            Research index →
          </a>
        </div>

        <div class="mt-8 grid gap-3 sm:grid-cols-3">
          <div class="rounded-[1.5rem] border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
            <p class="text-[10px] uppercase tracking-[0.25em] text-[var(--color-text-muted)]">Current role</p>
            <p class="mt-2 text-sm text-[var(--color-text-secondary)]">Spine surgery · education · clinical AI</p>
          </div>
          <div class="rounded-[1.5rem] border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
            <p class="text-[10px] uppercase tracking-[0.25em] text-[var(--color-text-muted)]">Live as of</p>
            <p class="mt-2 text-sm text-[var(--color-text-secondary)]">{dateLabel}</p>
          </div>
          <div class="rounded-[1.5rem] border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
            <p class="text-[10px] uppercase tracking-[0.25em] text-[var(--color-text-muted)]">Focus</p>
            <p class="mt-2 text-sm text-[var(--color-text-secondary)]">UBE, research, faculty, systems</p>
          </div>
        </div>
      </div>

      <div class="relative pb-2 lg:pb-0">
        <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] border border-[var(--color-border-strong)] bg-[var(--color-surface)] shadow-[0_30px_80px_rgba(0,0,0,0.45)]">
          <img
            src="/hero-desk.webp"
            alt="Surgeon's desk"
            class="absolute inset-0 h-full w-full object-cover object-center"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.12),transparent_32%),linear-gradient(180deg,rgba(0,0,0,0.1)_0%,rgba(0,0,0,0.18)_45%,rgba(0,0,0,0.75)_100%)]"></div>

          <div class="absolute left-5 top-5 right-5 flex items-start justify-between gap-3">
            <div class="rounded-full border border-white/15 bg-black/45 px-3 py-2 text-[10px] uppercase tracking-[0.22em] text-white/70 backdrop-blur-md">
              Living hub
            </div>
            <div class="rounded-full border border-white/15 bg-black/45 px-3 py-2 text-[10px] uppercase tracking-[0.22em] text-white/70 backdrop-blur-md">
              {dateLabel}
            </div>
          </div>

          <div class="absolute left-5 top-20 max-w-[15rem] rounded-[1.35rem] border border-white/10 bg-black/40 p-4 text-white backdrop-blur-md">
            <p class="text-[10px] uppercase tracking-[0.22em] text-white/55">Current signal</p>
            <p class="mt-2 text-sm leading-6 text-white/82">
              Clinical work, education, and publishing — all kept current on one surface.
            </p>
          </div>

          <div class="absolute bottom-5 left-5 right-5 rounded-[1.5rem] border border-white/10 bg-black/52 p-5 text-white backdrop-blur-md">
            <p class="text-[10px] uppercase tracking-[0.28em] text-white/55">Selected position</p>
            <p class="mt-2 text-2xl font-semibold tracking-[-0.04em] sm:text-3xl">Woon Tak Yuh, MD</p>
            <p class="mt-2 max-w-lg text-sm leading-6 text-white/70">
              Spine surgeon, endoscopic educator, and clinical AI researcher based around real-world practice and measurable output.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
